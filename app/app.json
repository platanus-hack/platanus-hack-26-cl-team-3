{
  "expo": {
    "name": "Hoodini",
    "slug": "capo-ar",
    "version": "0.8.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1116",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.capoar.app",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#080E18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Hoodini usa la cámara para leer la patente, reconocer el capó abierto e identificar testigos del tablero. Las imágenes se analizan en el teléfono.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Hoodini usa el micrófono para dictar tus preguntas al chat. El audio se envía a ElevenLabs para transcribirlo.",
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "capoar"
  }
}

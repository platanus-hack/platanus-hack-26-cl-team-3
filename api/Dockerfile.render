# Render monta el disco en tiempo de ejecución y no documenta sus permisos: este contenedor corre como root para poder escribir en él.
FROM node:22.20.0-slim
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --omit=dev
COPY src ./src
ENV NODE_ENV=production
EXPOSE 8787
CMD ["node_modules/.bin/tsx", "src/index.ts"]
